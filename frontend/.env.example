# Frontend environment variables
# Copy this file to .env and fill in values

# Backend API URL (used in development via Vite proxy)
VITE_API_URL=/api

# Production backend URL
# VITE_API_URL=https://spring-revival-api.onrender.com/api

# Supabase (for direct Storage uploads from client)
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_STORAGE_BUCKET=spring-photos
